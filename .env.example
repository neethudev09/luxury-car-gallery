# ── Public (client + SSR) — safe to expose, injected at build time ──
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ── Server runtime only — required by SSR / server functions ──
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"

# ── Secret — server only, NEVER expose to the client / commit ──
# Bypasses Row Level Security. Used by admin server operations.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
